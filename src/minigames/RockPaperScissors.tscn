[sub_resource type="Shader" id="48"]
code = "shader_type canvas_item;

uniform vec4 color : source_color;

void fragment() {
	COLOR = texture(TEXTURE, UV);
	if (COLOR.a > 0.0) {
		COLOR = color;
	}
}"

