; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="绒绒公园"
run/main_scene="res://src/ui/illustrated/StartPage.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/use_filter=false
boot_splash/image="res://sprites/etc/Loading.png"
config/icon="res://sprites/etc/BirdSymbol.png"
config/macos_native_icon="res://sprites/etc/BirdSymbol.icns"
config/windows_native_icon="res://sprites/etc/BirdSymbol.ico"

[autoload]

IntegerResolutionHandler="*uid://cr5nn5qt1gbbs"
Globals="*res://src/utils/Globals.gd"
AudioManager="*res://audio/AudioManager.tscn"
TransitionScreen="*res://src/effects/TransitionScreen.tscn"
TextBox="*res://src/ui/TextBox.tscn"
CircleTransition="*res://src/effects/CircleTransition.tscn"

[display]

window/integer_resolution_handler/base_width=192
window/integer_resolution_handler/base_height=144
window/size/viewport_width=192
window/size/viewport_height=144
window/size/window_width_override=576
window/size/window_height_override=432
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/integer_resolution_handler/plugin.cfg")

[importer_defaults]

texture={
"compress/bptc_ldr": 0,
"compress/hdr_mode": 0,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"compress/normal_map": 0,
"detect_3d": false,
"flags/anisotropic": false,
"flags/filter": false,
"flags/mipmaps": false,
"flags/repeat": 0,
"flags/srgb": 2,
"process/HDR_as_SRGB": false,
"process/fix_alpha_border": true,
"process/invert_color": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"size_limit": 0,
"stream": false,
"svg/scale": 1.0
}

